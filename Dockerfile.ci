FROM hashicorp/terraform:1.9.8 AS terraform

FROM python:3.12-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

COPY --from=terraform /bin/terraform /usr/local/bin/terraform

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        docker.io \
        git \
        postgresql-client \
    && terraform version \
    && docker --version \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY . .

RUN python -m venv /opt/semgrep \
    && /opt/semgrep/bin/python -m pip install --no-cache-dir --upgrade pip \
    && /opt/semgrep/bin/python -m pip install --no-cache-dir 'semgrep==1.178.0' \
    && ln -s /opt/semgrep/bin/semgrep /usr/local/bin/semgrep \
    && python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -e '.[dev]' \
    && python -m pip check \
    && semgrep --version

CMD ["bash", "scripts/full_project_gate.sh"]
