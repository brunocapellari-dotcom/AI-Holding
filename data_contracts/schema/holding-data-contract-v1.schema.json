{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-holding.local/schemas/holding-data-contract-v1.schema.json",
  "title": "Holding Data Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "dataset_key",
    "owner",
    "source",
    "grain",
    "schema",
    "quality",
    "provenance",
    "classification"
  ],
  "properties": {
    "contract_version": {"const": "holding-data-contract-v1"},
    "dataset_key": {"type": "string", "minLength": 2, "maxLength": 200},
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "project"],
      "properties": {
        "system": {"type": "string", "minLength": 2},
        "project": {"type": "string", "minLength": 2},
        "contact": {"type": ["string", "null"]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["registry_key"],
      "properties": {
        "registry_key": {"type": "string", "minLength": 2},
        "reference_date_field": {"type": ["string", "null"]},
        "publication_date_field": {"type": ["string", "null"]},
        "collection_date_field": {"type": ["string", "null"]},
        "competence_field": {"type": ["string", "null"]}
      }
    },
    "grain": {"type": "string", "minLength": 3},
    "primary_key": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "schema": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "nullable"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "nullable": {"type": "boolean"},
          "description": {"type": "string"},
          "unit": {"type": ["string", "null"]},
          "allowed_values": {"type": "array"}
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_age_seconds": {"type": "integer", "exclusiveMinimum": 0},
        "expected_frequency_seconds": {"type": "integer", "exclusiveMinimum": 0}
      }
    },
    "quality": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["check", "severity"],
        "properties": {
          "check": {"type": "string", "minLength": 2},
          "severity": {"enum": ["info", "warning", "blocking"]},
          "column": {"type": ["string", "null"]},
          "threshold": {},
          "engine_hint": {"type": ["string", "null"]}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {"type": "boolean"},
        "fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidence_retention": {"type": ["string", "null"]}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_classification", "truth_classification"],
      "properties": {
        "data_classification": {
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "truth_classification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["observed", "inferred", "estimated", "projected", "externally_confirmed"]
          },
          "uniqueItems": true
        },
        "contains_pii": {"type": "boolean", "default": false}
      }
    },
    "lineage": {
      "type": "array",
      "items": {"type": "string", "minLength": 2},
      "uniqueItems": true
    },
    "soda_adapter": {
      "type": ["object", "null"],
      "description": "Optional adapter metadata. Never replaces the native contract.",
      "additionalProperties": true
    }
  }
}
