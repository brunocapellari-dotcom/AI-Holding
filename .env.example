ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/holding
DATABASE_AUTH_MODE=password

# Cloud SQL automatic IAM authentication. Switch DATABASE_AUTH_MODE only after
# the production IAM login and database privileges have passed acceptance.
CLOUD_SQL_INSTANCE_CONNECTION_NAME=
CLOUD_SQL_IAM_USER=
CLOUD_SQL_DATABASE=holding
CLOUD_SQL_IP_TYPE=private

REQUIRE_VERIFIED_IDENTITY=true
VERIFIED_IDENTITY_AUDIENCE=holding-control-plane

PMO_IDENTITY_ISSUER=
PMO_IDENTITY_SUBJECT=
PMO_IDENTITY_EMAIL=
KNOWLEDGE_IDENTITY_ISSUER=
KNOWLEDGE_IDENTITY_SUBJECT=
KNOWLEDGE_IDENTITY_EMAIL=
AUDITOR_IDENTITY_ISSUER=
AUDITOR_IDENTITY_SUBJECT=
AUDITOR_IDENTITY_EMAIL=

OBSIDIAN_VAULT_PATH=
OBSIDIAN_KNOWLEDGE_ROOT=00 - Segundo Cerebro

# Optional production owner RBAC bootstrap. Configure all three together.
OWNER_IDENTITY_ISSUER=https://accounts.google.com
OWNER_IDENTITY_SUBJECT=
OWNER_IDENTITY_EMAIL=
