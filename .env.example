ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/holding
REQUIRE_VERIFIED_IDENTITY=true
VERIFIED_IDENTITY_AUDIENCE=holding-control-plane

# Existing worker identity bindings retained during AgentOS migration.
PMO_IDENTITY_ISSUER=
PMO_IDENTITY_SUBJECT=
PMO_IDENTITY_EMAIL=
KNOWLEDGE_IDENTITY_ISSUER=
KNOWLEDGE_IDENTITY_SUBJECT=
KNOWLEDGE_IDENTITY_EMAIL=
AUDITOR_IDENTITY_ISSUER=
AUDITOR_IDENTITY_SUBJECT=
AUDITOR_IDENTITY_EMAIL=

# Second Brain integration. The Holding writes candidates only to an intake area.
OBSIDIAN_VAULT_PATH=
OBSIDIAN_KNOWLEDGE_ROOT=00 - Segundo Cerebro/00 - Inbox/Holding

# Target services. Values are injected by the deployment/secrets layer; never commit them.
AGENTOS_ENABLED=false
LITELLM_BASE_URL=
LITELLM_VIRTUAL_KEY=
LANGFUSE_HOST=
INFISICAL_SITE_URL=
OPENHANDS_AGENT_SERVER_URL=
MCP_GATEWAY_URL=
